# 模型接口类型：gemini / deepseek / compatible；离线演示改为 mock；仅目录为 catalog
MODEL_PROVIDER=gemini
# 模型名由使用者填写；空值表示未配置真实模型
MODEL_NAME=
# 模型接口密钥，只在本机服务端保存
MODEL_API_KEY=
# compatible 的基础地址，保留服务要求的路径前缀（如 /v1）
MODEL_BASE_URL=
# 思考强度，按服务支持填写；不需要时留空
MODEL_REASONING_EFFORT=
# 额外请求参数，留空或填写单行 JSON 对象
MODEL_EXTRA_BODY=
# 单次产品模型调用超时，单位秒
MODEL_TIMEOUT_S=60
# 使用 local 在本机直接访问网页
DEPLOY_MODE=local
# 推荐策略，当前负责人指定保持团队基线
RECOMMENDER=s_team
# 带玩策略，当前保持计划加状态推进
TUTOR=t1
# 问答来源策略，当前保持 g2
GROUNDING=g2
# 一轮最多工具迭代次数
MAX_TOOL_ITERS=3
# 提交未通过校验时最多修正次数
MAX_SUBMIT_RETRIES=2
# 保留的对话历史轮数
HISTORY_TURNS=8
# 单个用户每天的模型 token 上限
DAILY_TOKEN_BUDGET=2000000
# 单个用户每分钟受限请求数
RATE_LIMIT_PER_MIN=20
# 产品 trace 目录，不提交到 Git
TRACE_DIR=data/traces
# 可选的独立 trace 文件；一般留空，按目录分文件记录
TRACE_FILE=
# 是否复用带玩计划缓存：1 开启，0 关闭
PLAN_CACHE=1
# 联网搜索：none 关闭，deepseek 为真实搜索，mock 为离线模拟
SEARCH_PROVIDER=none
# 搜索密钥；空值时尝试 MODEL_API_KEY 或旧 DEEPSEEK_API_KEY
SEARCH_API_KEY=
# 调试模式：1 开启，0 关闭
DEBUG=0
# 用户、会话、缓存和用量数据库路径，不提交到 Git
APP_DB_PATH=data/app.db
# 单次流式响应超时，单位秒
SSE_TIMEOUT_S=300
